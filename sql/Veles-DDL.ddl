CREATE OR REPLACE TRIGGER ARC_FKArc_1_StandardanKorisnik 
BEFORE INSERT OR UPDATE OF email 
ON StandardanKorisnik 
FOR EACH ROW 
DECLARE 
    d VARCHAR2 (32); 
BEGIN 
    SELECT A.tipKorisnika INTO d 
    FROM Korisnik A 
    WHERE A.email = :new.email; 
    IF (d IS NULL OR d <> 'StandardanKorisnik') THEN 
        raise_application_error(-20223,'FK StandardanKorisnik_FK in Table StandardanKorisnik violates Arc constraint on Table Korisnik - discriminator column tipKorisnika doesn''t have value ''StandardanKorisnik'''); 
    END IF; 
    EXCEPTION 
    WHEN NO_DATA_FOUND THEN 
        NULL; 
    WHEN OTHERS THEN 
        RAISE; 
END; 
/

